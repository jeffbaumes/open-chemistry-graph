---
import '../styles/site.css';
import '../styles/interactive.css';
import { base } from '../lib/nodes.js';
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Open chemistry graph</title>
  </head>
  <body>
    <header class="site"><a href={`${base}/`}>Open chemistry graph</a><a href={`${base}/contribute/`}>Contribute</a></header>
    <main><slot /></main>
  </body>
</html>
