---
import Base from '../layouts/Base.astro';
import queue from '../generated/tasks.json';
import { base, getNode } from '../lib/nodes.js';

const SHOWN = 6;
const REPO = 'https://github.com/jeffbaumes/open-chemistry-graph';
const kinds = [...new Set(queue.tasks.map((t) => t.kind))];
const groups = kinds.map((kind) => {
  const tasks = queue.tasks.filter((t) => t.kind === kind);
  return { kind, tasks, title: queue.kinds[kind]?.title, playbook: queue.kinds[kind]?.playbook ?? tasks[0].playbook };
});
const sections = [
  { mode: 'human', heading: 'With a person', blurb: 'These need someone who knows chemistry. An AI assistant guides you through, one step at a time.' },
  { mode: 'ai', heading: 'An AI agent alone', blurb: 'An agent can finish these by itself. The validator decides whether the work is accepted.' },
];
const { totals } = queue;
---
<Base title="Contribute">
  <p class="eyebrow">Contribute</p>
  <h1>Open tasks</h1>
  <p>
    This course is written by people and their AI assistants. Every lesson, exercise, interactive and video is open to improvement.
    There are <strong>{queue.tasks.length} open tasks</strong>.
  </p>

  <h2>What has been checked</h2>
  <p>The course has {totals.parts} separately reviewable parts: lesson texts, exercises, interactives and videos.</p>
  <ul class="tasks">
    <li><strong>{totals.recomputed} of {totals.exercises}</strong><span>exercise answers are recalculated by CI on every change</span></li>
    <li><strong>{totals.human} of {totals.parts}</strong><span>parts have been reviewed by a listed person</span></li>
    <li><strong>{totals.agent} of {totals.parts}</strong><span>parts have been checked by an independent AI run</span></li>
  </ul>
  <p class="muted more">
    A review names the exact version it covers and stops counting when that part changes. Who signed it is checked against their GitHub account, not typed in.
    <a href={`${REPO}/blob/main/TRUST.md`}>How trust works here</a>
  </p>
  <p>
    To help, point an AI coding assistant at the <a href={REPO}>repository</a> and ask it to pick up a task.
    It will find <a href={`${REPO}/blob/main/AGENTS.md`}>the instructions</a> and run the queue itself.
  </p>

  {sections.map(({ mode, heading, blurb }) => (
    <section class="unit">
      <h2>{heading}</h2>
      <p class="muted">{blurb}</p>
      {groups.filter((g) => g.tasks.some((t) => t.mode === mode)).map((group) => {
        const tasks = group.tasks.filter((t) => t.mode === mode);
        return (
          <div class="task-group">
            <h3>{group.title ?? tasks[0].title} <span class="muted">{tasks.length}</span></h3>
            <ul class="tasks">
              {tasks.slice(0, SHOWN).map((t) => (
                <li>
                  <code>{t.id}</code>
                  <span>{t.node && getNode(t.node) ? <a href={`${base}/${t.node}/`}>{getNode(t.node).title}</a> : t.title}{t.node ? '' : `. ${t.detail}`}</span>
                </li>
              ))}
            </ul>
            {tasks.length > SHOWN && <p class="muted more">and {tasks.length - SHOWN} more: <code>python3 tasks.py list --kind {group.kind}</code></p>}
          </div>
        );
      })}
    </section>
  ))}
</Base>
