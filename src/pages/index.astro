---
import Base from '../layouts/Base.astro';
import { course, wanted, trustOf, base, titleOf } from '../lib/nodes.js';
import { toHtml } from '../lib/chem.js';

// How many of a lesson's parts have at least one review of each kind.
function standing(id) {
  const parts = Object.values(trustOf(id));
  return { parts: parts.length, human: parts.filter((p) => p.human.length).length, agent: parts.filter((p) => p.agent.length).length };
}
---
<Base title="Lessons">
  <p class="eyebrow">Contents</p>
  <h1>High school chemistry</h1>
  <p class="muted">Short lessons with interactive models and practice problems, ordered so each builds on the ones before it.</p>
  <p class="muted">Written with AI. Each part shows how many people and independent AI runs have reviewed it. <a href={`${base}/contribute/`}>How review works</a></p>

  {course.map((unit, u) => (
    <section class="unit">
      <h2><span class="muted">Unit {u + 1}</span> {unit.title}</h2>
      <ol class="contents">
        {unit.nodes.map((node, i) => (
          <li>
            <span class="index">{u + 1}.{i + 1}</span>
            <a href={`${base}/${node.id}/`}>{node.title}</a>
            <p class="muted" set:html={toHtml(node.summary)} />
            <p class={`reviewed ${standing(node.id).human === standing(node.id).parts ? 't-yes' : ''}`}>
              Human-reviewed {standing(node.id).human}/{standing(node.id).parts} · AI-reviewed {standing(node.id).agent}/{standing(node.id).parts}
            </p>
          </li>
        ))}
      </ol>
    </section>
  ))}

  {wanted.length > 0 && (
    <>
      <h2>Not written yet</h2>
      <p class="muted">Lessons above depend on these. They are the next ones to write.</p>
      <ul class="wanted">{wanted.map((id) => <li>{titleOf(id)}</li>)}</ul>
    </>
  )}
</Base>
