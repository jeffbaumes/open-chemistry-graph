---
import Base from '../layouts/Base.astro';
import Exercise from '../components/Exercise.astro';
import Animation from '../components/Animation.astro';
import Interactive from '../components/Interactive.astro';
import Trust from '../components/Trust.astro';
import { nodes, getNode, neighbors, trustOf, base, titleOf } from '../lib/nodes.js';

export function getStaticPaths() {
  return nodes.map((node) => ({ params: { id: node.id } }));
}

const node = getNode(Astro.params.id);
const { Content } = node;
const { previous, next } = neighbors(node.id);
const trust = trustOf(node.id);
---
<Base title={node.title}>
  {node.prerequisites.length > 0 && (
    <p class="prereqs">
      Before this: {node.prerequisites.map((id, i) => (
        <>
          {i > 0 && ', '}
          {getNode(id) ? <a href={`${base}/${id}/`}>{getNode(id).title}</a> : <span>{titleOf(id)} (not written yet)</span>}
        </>
      ))}
    </p>
  )}

  <article class="lesson"><Content /></article>

  <Trust part={trust.lesson} invite />

  {node.animation && <Animation scene={node.animation} trust={trust.animation} />}

  {node.interactives.map((interactive, i) => <Interactive {...interactive} trust={trust[`interactive-${i + 1}`]} />)}

  <section class="practice">
    <h2>Practice</h2>
    {node.exercises.map((ex, i) => <Exercise ex={ex} n={i + 1} trust={trust[`exercise-${i + 1}`]} />)}
  </section>

  <nav class="lesson-nav" aria-label="Lessons">
    {previous ? <a href={`${base}/${previous.id}/`}><span>Previous</span>{previous.title}</a> : <span />}
    {next && <a class="next" href={`${base}/${next.id}/`}><span>Next</span>{next.title}</a>}
  </nav>
</Base>
